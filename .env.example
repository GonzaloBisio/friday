# === FRIDAY Configuration ===

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_REASONING=gemini-2.5-pro
GEMINI_MODEL_FAST=gemini-2.5-flash

# NEXCOURT
# Modo de acceso: "direct" (management ports 908x) o "kong" (via gateway)
NEXCOURT_MODE=direct
# Host para modo directo (sin http:// ni puerto)
NEXCOURT_DIRECT_HOST=http://localhost
# URL del gateway Kong para modo kong
NEXCOURT_KONG_URL=https://dev-api.nexcourts.com
# Servicios a monitorear con sus puertos de gestión
# Esto está pre-configurado en config.py, solo listá acá los que quieras activar
NEXCOURT_SERVICES_CONFIG={"clubs-service":{"mgmt_port":9081,"kong_path":"clubs"},"reservations-service":{"mgmt_port":9082,"kong_path":"reservations"},"stock-service":{"mgmt_port":9083,"kong_path":"stock"},"reports-service":{"mgmt_port":9084,"kong_path":"reports"},"sports-service":{"mgmt_port":9085,"kong_path":"sports"},"media-service":{"mgmt_port":9086,"kong_path":"media"},"notifications-service":{"mgmt_port":9087,"kong_path":"notifications"}}
# Legacy: lista plana de servicios activos (si no usás el config estructurado)
NEXCOURT_SERVICES=[]
NEXCOURT_API_KEY=
NEXCOURT_POLL_INTERVAL_SECONDS=30

# Storage
DB_PATH=friday.db

# System collector
SYSTEM_POLL_INTERVAL_SECONDS=10

# Gemini usage tracking
GEMINI_COST_PER_1K_INPUT_TOKENS=0.00125
GEMINI_COST_PER_1K_OUTPUT_TOKENS=0.005

# API server
API_PORT=8000
