# === FRIDAY Configuration ===

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_REASONING=gemini-2.5-pro
GEMINI_MODEL_FAST=gemini-2.5-flash

# NEXCOURT
NEXCOURT_BASE_URL=https://localhost:8443
NEXCOURT_SERVICES=nexcourt-clubs-service
NEXCOURT_API_KEY=
NEXCOURT_POLL_INTERVAL_SECONDS=30

# Storage
DB_PATH=friday.db

# System collector
SYSTEM_POLL_INTERVAL_SECONDS=10

# Gemini usage tracking
GEMINI_COST_PER_1K_INPUT_TOKENS=0.00125
GEMINI_COST_PER_1K_OUTPUT_TOKENS=0.005
