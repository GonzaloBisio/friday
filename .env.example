# === FRIDAY Configuration ===
# Solo definí acá lo que quieras CAMBIAR: los defaults viven en friday/config.py.
# ⚠️ Si copiás un .env viejo (Ubuntu/WSL), BORRÁ las líneas GEMINI_MODEL_* con
# modelos 2.x: Google los dejó "access limited" / apagados y pisarían los defaults.

# --- Cerebro ---
LLM_PROVIDER=gemini                 # "ollama" para 100% local/offline
GEMINI_API_KEY=your-gemini-api-key-here
# Overrides opcionales (ver docs/MODELS.md):
# GEMINI_MODEL_FAST=gemini-3.5-flash-lite   # modo calidad: gemini-3.6-flash
# GEMINI_MODEL_BALANCED=gemini-3.8-flash
# GEMINI_MODEL_LITE=gemini-3.5-flash-lite
# GEMINI_MODEL_REASONING=gemini-3.1-pro-preview
# OLLAMA_MODEL=gemma4:e4b-it-qat     # o gemma4:12b-it-qat si te sobra RAM
# OLLAMA_NUM_CTX=8192
# OLLAMA_THINK=false                # Gemma 4 responde vacío si piensa (ver MODELS.md)

# --- NEXCOURT ---
# Modo: "direct" (management ports 908x), "kong" (gateway) o "cloudwatch" (AWS ECS)
NEXCOURT_MODE=direct
NEXCOURT_DIRECT_HOST=http://localhost
NEXCOURT_KONG_URL=https://dev-api.nexcourts.com
NEXCOURT_API_KEY=
NEXCOURT_POLL_INTERVAL_SECONDS=30

# --- AXIS (SSH alias "axis" en ~/.ssh/config) ---
# AXIS_ENABLED=true

# --- Storage ---
DB_PATH=friday.db

# --- API ---
API_PORT=8000
# API_HOST=127.0.0.1                 # no abrir a la red: la API no tiene auth

# --- Voz (listener) ---
# TTS_VOICE=charles                 # voz de Pocket TTS sin clonar (muestras: voices/samples/)
# VOICES_DIR=                        # default: ./voices (macOS) · %USERPROFILE%\friday\voices (Windows)
